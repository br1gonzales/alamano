{
  "name": "alamano",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "node --stack-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx --test tests/lastMileDelivery.test.ts",
    "build:web": "npx expo export --platform web",
    "deploy": "npx expo export --platform web && npx eas deploy --prod --non-interactive",
    "update:prod": "npx eas update --channel production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~57.0.24",
    "expo-crypto": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
